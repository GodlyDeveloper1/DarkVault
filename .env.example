# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.
# The operator desk's key: 24 characters or more. Make a fresh one, e.g. in PowerShell:
#   -join ((48..57)+(97..122) | Get-Random -Count 32 | % {[char]$_})
VAULT_OPERATOR_KEY=
WEB_PORT=3100
VAULT_MIN_CONFIRMATIONS=3
# LIGHTWALLETD_URL=https://testnet.zec.rocks:443
# HOUSE_SIGNER_URL=        (empty: no practice auctions)
# TRUST_PROXY=1            (only behind your own reverse proxy)
