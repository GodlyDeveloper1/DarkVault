# Settings for the web app. Copy to .env.local and fill in. See the README for all of them.

# Practice auctions and practice wallets: where the house signer listens
# (scripts\house-signer.ps1 starts it on this port). Remove this line to run without them.
HOUSE_SIGNER_URL=http://127.0.0.1:8083

# Turns on the operator's routes (disputes, the house purse). 24 characters or more. Keep it secret.
VAULT_OPERATOR_KEY=
