# Caddy in front of Dark Vault: HTTPS for the domain, certificates renewed by
# itself. It keeps no access log (Caddy logs requests only when told to).
# No global email: Caddy gets certificates without one, and an empty
# ACME_EMAIL there made Caddy refuse to start.

{$DOMAIN} {
	encode zstd gzip
	# The visitor's address goes to the web app only as the last X-Forwarded-For
	# entry, for its in-memory rate limits (TRUST_PROXY=1). Nothing logs it.
	reverse_proxy web:3100
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
